# Non-secret defaults for the Nick's billing LXC.
# Override by exporting vars before install.sh.

# Proxmox guest — next free after lexis-markets CT 117 / 10.0.0.58
CTID=118
CT_HOSTNAME=nicks-billing
CT_IP=10.0.0.60
CT_GW=10.0.0.1
CT_CIDR=16
BRIDGE=vmbr0
STORAGE=TN-VM-Backup
TEMPLATE_STORAGE=local
OSTEMPLATE=debian-12-standard_12.12-1_amd64.tar.zst
MEMORY=1024
CORES=2
DISK_GB=16
UNPRIVILEGED=1
FEATURES=nesting=0
START_ON_BOOT=1
HA_GROUP=

# App paths inside CT
APP_ROOT=/opt/nicks_lawn_care_billing
APP_USER=billing
ENV_FILE=/etc/nicks-billing.env
# Writable ray-hive tree: job submit uploads this as working_dir (no vLLM here).
RAY_HIVE_ROOT=/opt/ray-hive
RAY_HIVE_CLONE_URL=https://github.com/BasicOverflow/ray-hive.git

# Public Gitea app repo once this tree is pushed (install.sh also accepts SRC_DIR)
# Gitea mirror of https://github.com/BasicOverflow/nicks_lawn_care_billing (hourly)
REPO_RAW_BASE=http://10.0.0.52:3000/admin/nicks_lawn_care_billing/raw/branch/main
REPO_CLONE_URL=http://10.0.0.52:3000/admin/nicks_lawn_care_billing.git
