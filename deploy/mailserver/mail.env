# docker-mailserver lab defaults — override in production
OVERRIDE_HOSTNAME=mail.basicoverflow.com
ENABLE_SPAMASSASSIN=0
ENABLE_CLAMAV=0
ENABLE_FAIL2BAN=1
ENABLE_POSTGREY=0
ONE_DIR=1
DMS_DEBUG=0
SPOOF_PROTECTION=1
ENABLE_SRS=0
PERMIT_DOCKER=network
TLS_LEVEL=modern
POSTMASTER_ADDRESS=postmaster@basicoverflow.com
