# Ray / OCR
RAY_ADDRESS=ray://10.0.1.52:10001
RAY_DASHBOARD=http://10.0.1.52:8265
RAY_SERVE=http://10.0.1.52:8000
RAY_HIVE=C:\Users\Peter\Desktop\ray-hive
# Ray Jobs pip-install this on workers (match cluster images, currently 0.2.1).
RAY_HIVE_PIP=ray-hive==0.2.1
HIVE_PIP_EXTRA_INDEX=http://10.0.0.52:3000/api/packages/admin/pypi/simple/
NINI_NOVEL=1
NINI_IMAGE_EDGE=2800
# Ray-hive: keep this VL model loaded. Sleep/idle leave a replica that looks up but returns 500.
NINI_SLEEP_TIMEOUT=-1
NINI_IDLE_TIMEOUT=-1

# Postgres Fast (homelab)
DATABASE_URL=postgresql://postgres:CHANGE_ME@10.0.220.145:5433/nicks_billing

# MinIO Fast (homelab) — fill access keys
S3_ENDPOINT=http://10.0.220.145:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=nicks-lawn-billing
S3_REGION=us-east-1

# Gmail SMTP. From must be this Gmail address. Password is an app password
# from the Google account (2-Step Verification, then App passwords), not the
# normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
SMTP_FROM=you@gmail.com
